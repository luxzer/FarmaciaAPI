@page "/medicamentos"
@inject IFarmaciaApiServicio Api
@inject ILogger<Medicamentos> Logger

<PageTitle>Medicamentos</PageTitle>

<div class="contenedor seccion">

    <div class="seccion-titulo">
        <h1>Catalogo de medicamentos</h1>
        <p>Datos pedidos en vivo a <code>GET /api/medicamentos</code>.</p>
    </div>
    <BuscadorMedicamentos Texto="@_texto"
                          Filtro="@_filtro"
                          TextoCambio="CambioTexto"
                          FiltroCambio="CambioFiltro" />

    @if (_error)
    {
        <div class="aviso aviso-error">
            No se pudo contactar la Web API. Comprueba que el proyecto
            <strong>FarmaciaAPI</strong> este corriendo en @DireccionApi.
        </div>
    }
    <ResumenInventario Total="_todos.Count"
                       StockBajo="@_todos.Count(m => m.Stock <= _umbral)"
                       ConReceta="@_todos.Count(m => m.RequiereReceta)"
                       Unidades="@_todos.Sum(m => m.Stock)" />

    @if (_cargando)
    {
        <Cargando Texto="Consultando el catalogo..." />
    }
    else if (_visibles.Count == 0)
    {
        <SinResultados Mensaje="Ningun medicamento coincide con la busqueda." />
    }
    else
    {
        <p class="descripcion" style="margin:24px 0 14px">
            Mostrando @_visibles.Count de @_todos.Count medicamentos.
            @if (_seleccionado is not null)
            {
                <span> Seleccionado: <strong>@_seleccionado.Nombre</strong>.</span>
            }
        </p>
        <div class="rejilla rejilla-3">
            @foreach (var m in _visibles)
            {
                <TarjetaMedicamento Item="m"
                                    UmbralStockBajo="_umbral"
                                    Seleccionado="@(_seleccionado?.Id == m.Id)"
                                    AlSeleccionar="SeleccionarMedicamento" />
            }
        </div>
    }
</div>

@code {
    private List<Medicamento> _todos = new();
    private List<Medicamento> _visibles = new();
    private Medicamento? _seleccionado;

    private string? _texto;
    private BuscadorMedicamentos.FiltroCatalogo _filtro = BuscadorMedicamentos.FiltroCatalogo.Todos;

    private int _umbral = 50;
    private bool _cargando = true;
    private bool _error;

    [Inject] private IConfiguration Config { get; set; } = default!;
    private string? DireccionApi => Config["FarmaciaApi:BaseUrl"];

    protected override async Task OnInitializedAsync()
    {
        // el umbral lo manda la API
        var stockBajo = await Api.ObtenerStockBajoAsync();
        if (stockBajo is not null)
            _umbral = stockBajo.Umbral;

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;

        var resultado = await Api.ObtenerMedicamentosAsync(_texto);

        _todos = resultado.ToList();
        _error = _todos.Count == 0 && string.IsNullOrWhiteSpace(_texto);
        _cargando = false;

        AplicarFiltro();
    }

    // los filtros se aplican en memoria, no hace falta volver a pedir a la API
    private void AplicarFiltro()
    {
        _visibles = _filtro switch
        {
            BuscadorMedicamentos.FiltroCatalogo.StockBajo => _todos.Where(m => m.Stock <= _umbral).ToList(),
            BuscadorMedicamentos.FiltroCatalogo.ConReceta => _todos.Where(m => m.RequiereReceta).ToList(),
            BuscadorMedicamentos.FiltroCatalogo.PorVencer => _todos.Where(m => m.PorVencer).ToList(),
            _ => _todos.ToList()
        };

        // si el seleccionado quedo fuera del filtro, se deselecciona
        if (_seleccionado is not null && _visibles.All(m => m.Id != _seleccionado.Id))
            _seleccionado = null;
    }

    private async Task CambioTexto(string? texto)
    {
        _texto = texto;
        await CargarAsync();
    }

    private void CambioFiltro(BuscadorMedicamentos.FiltroCatalogo filtro)
    {
        _filtro = filtro;
        AplicarFiltro();
    }

    private void SeleccionarMedicamento(Medicamento m)
    {
        // click sobre la que ya estaba seleccionada = deseleccionar
        _seleccionado = _seleccionado?.Id == m.Id ? null : m;

        if (_seleccionado is not null)
            Logger.LogInformation("Medicamento seleccionado: {Nombre} (Id={Id})", m.Nombre, m.Id);
    }
}
