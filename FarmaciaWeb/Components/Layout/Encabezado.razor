@inject IConfiguration Config

<header class="encabezado">
    <div class="contenedor encabezado-fila">

        <a class="marca" href="/">
            <img src="img/logo.svg" alt="Logotipo de @Nombre" />
            <span>
                <span class="marca-nombre">@Nombre</span><br />
                <span class="marca-lema">@Lema</span>
            </span>
        </a>

        <nav class="navegacion">
            <NavLink href="" Match="NavLinkMatch.All">Inicio</NavLink>
            <NavLink href="medicamentos">Medicamentos</NavLink>
            <NavLink href="clientes">Clientes</NavLink>
        </nav>

        <div class="encabezado-contacto">
            <strong>@Telefono</strong>
            @Horario
        </div>

    </div>
</header>

@code {
    private string Nombre => Config["Sitio:Nombre"] ?? "Farmacia";
    private string? Lema => Config["Sitio:Lema"];
    private string? Telefono => Config["Sitio:Telefono"];
    private string? Horario => Config["Sitio:Horario"];
}
